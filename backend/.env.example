# Wszystkie ustawienia backendu (app/config.py). Skopiuj do backend/.env i uzupełnij.
# Kolejność: zmienne środowiskowe (Kubernetes ConfigMap/Secret, docker compose) > backend/.env > domyślne.

# --- Ogólne ---
APP_NAME=Duck CFO API
LOG_LEVEL=INFO
# Dla dev-serwera Angulara; w docker compose / Kubernetes frontend i API mają ten sam adres (nginx).
CORS_ORIGINS=["http://localhost:4200"]

# --- OpenShift AI: model serwowany przez KServe/vLLM (API zgodne z OpenAI) ---
# Stan połączenia: GET http://localhost:8000/api/ai/status
# URL:   „Inference endpoint” wdrożonego modelu + /v1 na końcu, np.:
#          z zewnątrz (Route): https://<model>-<projekt>.apps.<domena-klastra>/v1
#          w klastrze:         http://<model>-predictor.<projekt>.svc.cluster.local:8080/v1
# MODEL: nazwa modelu — sprawdź:  GET <URL>/models  (pole data[].id)
# TOKEN: przy „Require token authentication” — token z sekcji „Token authentication” modelu
#        albo `oc create token <service-account> -n <projekt>`. Puste = bez autoryzacji.
OPENSHIFT_AI_URL=https://my-model-my-project.apps.cluster.example.com/v1
OPENSHIFT_AI_MODEL=granite
OPENSHIFT_AI_TOKEN=
# Weryfikacja TLS; przy self-signed ustaw false albo wskaż CA w OPENSHIFT_AI_CA_BUNDLE
OPENSHIFT_AI_VERIFY_SSL=true
OPENSHIFT_AI_CA_BUNDLE=
# Limit czasu odpowiedzi modelu (s) — agenci generują dłuższe odpowiedzi JSON
OPENSHIFT_AI_TIMEOUT=90
# Wymuszenie odpowiedzi w JSON (response_format=json_object). false, jeśli serwer zwraca HTTP 400.
OPENSHIFT_AI_JSON_MODE=true
# Dopóki model nie jest podłączony: true = rekomendacje DEMO z reguł, false = błąd na stronie.
AGENTS_DEMO_FALLBACK=true

# --- Baza danych ---
# Lokalnie bez Dockera: SQLite (plik backend/data/duckbank.db, tworzony automatycznie):
DATABASE_URL=sqlite:///data/duckbank.db
# PostgreSQL z docker compose (port 5432 wystawiony na localhost):
# DATABASE_URL=postgresql+psycopg://duckbank:duckbank@localhost:5432/duckbank
# W docker compose / Kubernetes DATABASE_URL ustawia compose / Secret (host: postgres).
# Ile razy i co ile sekund próbować połączyć się z bazą przy starcie (baza w kontenerze może jeszcze wstawać)
DB_CONNECT_RETRIES=30
DB_CONNECT_RETRY_SECONDS=2

# --- Logowanie ---
SESSION_DAYS=7
# true za HTTPS (Route na OpenShift / Ingress z TLS) — cookie sesji tylko po HTTPS
COOKIE_SECURE=false

# --- Konto demo (tworzone przy pierwszym starcie, z zaimportowanym wyciągiem) ---
DEMO_USERNAME=demo
DEMO_PASSWORD=demo
DEMO_NAME=Vincenzo Amalfi
DEMO_BUSINESS=Pizzeria Amalfi
DEMO_EMAIL=vincenzo@pizzeria-amalfi.example
DEMO_SEGMENT=Business client · SME
STATEMENT_CSV_PATH=app/data/pizzeria-amalfi-bank-statement-2025-v6.csv
# Saldo na 01.01.2025 (przed pierwszą transakcją z pliku)
STATEMENT_OPENING_BALANCE=2500
