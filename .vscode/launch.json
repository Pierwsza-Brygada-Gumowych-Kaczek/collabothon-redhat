{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: FastAPI (uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--port", "8000"],
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "envFile": "${workspaceFolder}/backend/.env",
      "jinja": true,
      "console": "integratedTerminal"
    },
    {
      "type": "node-terminal",
      "name": "Frontend: ng serve",
      "request": "launch",
      "command": "npm run ng -- run frontend:serve:development",
      "cwd": "${workspaceFolder}/frontend"
    }
  ],
  "compounds": [
    {
      "name": "Backend + Frontend",
      "configurations": ["Backend: FastAPI (uvicorn)", "Frontend: ng serve"]
    }
  ]
}
